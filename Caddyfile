# =============================================================================
# Caddy — TLS termination and hostname routing.
# =============================================================================
# This is the entire edge configuration. It is short on purpose: the previous
# deployment used Traefik, where the same routing lived in Docker labels spread
# across several services and could not be read in one place.
#
# Certificates are obtained from Let's Encrypt automatically on first request
# for a hostname and renewed in the background. Two things have to be true or
# issuance fails:
#
#   1. The hostname's DNS A record already points at this VM's public IP.
#   2. Port 80 is reachable from the internet — the ACME HTTP challenge uses it.
#      That is the only reason port 80 is open; all real traffic is redirected
#      to HTTPS, which Caddy does by default with no configuration.
#
# CHAT_DOMAIN, ADMIN_DOMAIN and ACME_EMAIL come from the environment. During
# staging they are the staging hostnames; at cutover they become the production
# ones and the stack is redeployed, at which point Caddy issues new certificates
# on demand. Nothing else changes.
# =============================================================================

{
	# Where Let's Encrypt sends expiry warnings and problem reports. Use a real
	# address that someone reads — this is how you find out about a renewal
	# failure before your users do.
	email {$ACME_EMAIL}
}

# --- The chat application ----------------------------------------------------
{$CHAT_DOMAIN} {
	# --- Generated letters ---------------------------------------------------
	# Serves what the LetterWriter MCP writes, and exists because LibreChat
	# v0.8.7 does not read `blob` from an MCP embedded resource — it drops the
	# bytes and hands the model a description of a file nobody can open. So the
	# MCP writes the .docx here and returns a URL instead. Only present when the
	# mcp-letterwriter profile is enabled; harmless otherwise, since the
	# directory is simply empty.
	#
	# handle_path strips the /letters prefix, so /letters/<token>/<name>.docx
	# reads <root>/<token>/<name>.docx.
	#
	# ⚠️  Three properties are load-bearing, and none of them announces itself if
	# it breaks:
	#
	#   1. NO `browse`. Directory listing would let anyone enumerate every
	#      token and therefore every letter. It is off by default — do not
	#      turn it on, and note that `file_server browse` is a one-word change.
	#   2. This block must come BEFORE the catch-all `handle`, or the reverse
	#      proxy takes the request and LibreChat answers 404.
	#   3. The mount is read-only here. Caddy has no reason to write, and a
	#      writable public-facing document root is worth never having.
	#
	# The URL is a capability — holding it is sufficient to fetch the letter,
	# with no LibreChat session required. The token is 24 CSPRNG bytes. The
	# letter's text is already in the conversation that produced it, so the file
	# exposes nothing that conversation does not. See docs/modules/mcp-letterwriter.md.
	handle_path /letters/* {
		root * /srv/letters
		header Content-Disposition attachment
		file_server
	}

	# LibreChat streams responses token by token over Server-Sent Events. Caddy's
	# reverse proxy passes those through without buffering by default, so no
	# flush interval or buffering directives are needed here. Adding response
	# buffering would make every answer appear all at once at the end.
	handle {
		reverse_proxy api:3080
	}

	encode zstd gzip

	log {
		output file /data/log/chat-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# --- The admin panel ---------------------------------------------------------
# Its own hostname so it can be restricted or taken offline independently of the
# chat application. Authorization is still LibreChat's — the panel is a thin
# client over /api/admin/* and a signed-in user without the ADMIN role gets
# nothing from it. This separation is about blast radius, not authentication.
#
# To restrict it to your office network, uncomment the matcher below and list
# your egress addresses. Do this only once you are certain of those addresses:
# locking yourself out of the admin panel is recoverable, but annoying.
#
#	@notoffice not remote_ip 203.0.113.0/24
#	respond @notoffice 403
{$ADMIN_DOMAIN} {
	reverse_proxy admin-panel:3000

	encode zstd gzip

	log {
		output file /data/log/admin-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
