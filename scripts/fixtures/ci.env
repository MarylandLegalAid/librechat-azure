# Placeholder values so `docker compose config` can be parsed in CI and locally.
#
# NOT SECRETS AND NOT USABLE. Nothing here reaches a running deployment — the
# real .env is generated on the VM from Azure Key Vault by render-env.sh. These
# exist only so that variable interpolation resolves and the Compose files can
# be checked for syntax and structure.
#
# If a new required variable is added to compose.yaml, add a placeholder here or
# validation fails with "variable is not set", which is the point.

DATA_DIR=/tmp/librechat-ci-data
FILE_STORAGE=disk

CHAT_DOMAIN=chat.example.org
ADMIN_DOMAIN=chat-admin.example.org
ACME_EMAIL=ci@example.org
DOMAIN_CLIENT=https://chat.example.org
DOMAIN_SERVER=https://chat.example.org
ADMIN_PANEL_URL=https://chat-admin.example.org

ADMIN_PANEL_SESSION_SECRET=ci-placeholder-not-a-secret
MEILI_MASTER_KEY=ci-placeholder-not-a-secret
POSTGRES_PASSWORD=ci-placeholder-not-a-secret
POSTGRES_DB=librechat
POSTGRES_USER=librechat

RAG_PORT=8000
