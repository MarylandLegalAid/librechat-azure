# =============================================================================
# Non-secret defaults, shared by every deployment of this blueprint.
# =============================================================================
# This file is COMMITTED and must never contain a secret. It is the first half of
# the .env that scripts/render-env.sh assembles on the VM:
#
#     env.defaults  (this file, from git)
#         ↓  then
#     Azure Key Vault  (secrets and per-deployment values)
#         ↓
#     .env  (mode 0600, regenerated on every deploy, never committed)
#
# Key Vault wins on conflict. So to change a value here for your own deployment,
# do not edit this file — set the same name as a Key Vault secret and it will
# override. That keeps your fork mergeable with upstream.
#
# Everything here is either identical for all deployments or a safe starting
# point. Anything organization-specific (domains, titles, credentials) is
# deliberately absent — see .env.example for the full catalogue and where each
# value is meant to come from.
# =============================================================================


# --- Deployment --------------------------------------------------------------

# The mounted Azure data disk. Everything that must survive an OS-disk rebuild
# lives under here. infra/cloud-init.yaml mounts it by UUID.
DATA_DIR=/srv/librechat/data

# Storage mode: `disk` or `s3`. Selects BOTH config/storage/<mode>.yaml and
# compose.storage.<mode>.yml, so the two halves cannot drift apart.
# See config/storage/README.md.
FILE_STORAGE=disk

# Optional services, comma-separated. Empty means the minimum working stack.
# Available: mcp-legalserver, mcp-letterwriter
COMPOSE_PROFILES=

# The systemd timer that runs deploy.sh every five minutes. This is the entire
# autodeploy configuration for a grantee: the repository is public, so `git pull`
# needs no credentials at all.
#
# Set to false where deploys are triggered by GitHub Actions instead, so a timer
# run cannot race a pipeline run. Maryland Legal Aid sets false in Key Vault.
DEPLOY_TIMER_ENABLED=true


# --- Chat models -------------------------------------------------------------
# Only models listed here can be selected by users.

ENDPOINTS=openAI,anthropic,agents

ANTHROPIC_MODELS=claude-opus-5,claude-sonnet-5,claude-haiku-4-5

# ⚠️  This contains ONE model, and that is deliberate — it is not a truncated
# list and not a typo.
#
# The GPT-5.6 family reaches users through a separate custom endpoint declared
# in librechat.yaml, because those models reject reasoning combined with
# function tools on /v1/chat/completions. Adding them here would expose them
# through the built-in endpoint, which does not force the Responses API, and
# they would fail at request time whenever a tool was used — with no startup
# error to warn you.
#
# gpt-5.4-nano stays here because the built-in endpoint still serves it for
# chat-title generation and the memory agent.
#
# Read docs/modules/models-gpt56-responses.md before changing this line.
OPENAI_MODELS=gpt-5.4-nano


# --- Specialist models -------------------------------------------------------
# FROZEN. These are not part of a chat-model refresh and each has a reason.

# ⚠️  Changing the embedding model invalidates every vector already stored in
# pgvector. File chat does not error — it returns confident nonsense — until
# every document in the system has been re-uploaded. Changing this is a separate
# project with a re-embedding step, never a line edit.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small

IMAGE_GEN_OAI_MODEL=gpt-image-2

# Content moderation stays off as a deliberate prior decision, not an oversight.
OPENAI_MODERATION=false


# --- Search ------------------------------------------------------------------

SEARCH=true
MEILI_NO_ANALYTICS=true


# --- Server ------------------------------------------------------------------

# Required behind Caddy. Without it LibreChat sees every request as coming from
# the proxy's address, which breaks rate limiting and audit logs.
TRUST_PROXY=1

# Ask search engines not to index this instance.
NO_INDEX=true

CONSOLE_JSON=false

RAG_PORT=8000

# pgvector connection. The password is a secret and lives in Key Vault as
# POSTGRES-PASSWORD; these two are not.
POSTGRES_DB=librechat
POSTGRES_USER=librechat

# The admin panel is always served over HTTPS by Caddy.
ADMIN_PANEL_SESSION_COOKIE_SECURE=true

APP_TITLE=LibreChat


# --- Authentication ----------------------------------------------------------
# Default: email and password, with self-registration ON so the first
# administrator can create an account. Single sign-on is an opt-in module.
#
# ⚠️  Before you expose a new instance to the internet, do ONE of these:
#     - add `registration.allowedDomains` to librechat.yaml (see that file), or
#     - set ALLOW_REGISTRATION=false once your accounts exist.
# Otherwise anyone who finds the URL can create an account.
# See docs/quickstart/04-first-login.md.

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

# Users cannot delete their own accounts. For an organization with record
# retention obligations, account deletion is an administrative action with a
# paper trail, not a self-service button. Administrators can still remove users
# through the Admin Panel. LibreChat enables this by default if the variable is
# omitted, so it is set explicitly rather than left to the default.
ALLOW_ACCOUNT_DELETION=false

SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7
