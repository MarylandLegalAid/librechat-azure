# =============================================================================
# The complete variable catalogue. No values — this file is documentation.
# =============================================================================
# You do not create a .env by copying this file. On the VM, .env is generated on
# every deploy by scripts/render-env.sh and overwritten each time:
#
#     env.defaults  (committed, non-secret)          ← blueprint-wide defaults
#         ↓  then
#     Azure Key Vault  (your secrets + your values)  ← wins on conflict
#         ↓
#     .env  (mode 0600, root-owned, never committed)
#
# So "setting a variable" means one of two things:
#   - it belongs to every deployment → change env.defaults and commit
#   - it belongs to yours            → write it to Key Vault
#
#
# ⚠️  THE ONE THING THAT CONFUSES EVERYONE
#
# Azure Key Vault secret names CANNOT CONTAIN UNDERSCORES. render-env.sh
# translates dashes to underscores, so:
#
#     Key Vault secret name        becomes environment variable
#     ---------------------        ----------------------------
#     OPENID-CLIENT-SECRET    →    OPENID_CLIENT_SECRET
#     CREDS-KEY               →    CREDS_KEY
#     ANTHROPIC-API-KEY       →    ANTHROPIC_API_KEY
#
# Store OPENID-CLIENT-SECRET, not OPENID_CLIENT_SECRET. The latter is rejected
# by Azure with a validation error; a name with a typo in it is accepted
# silently and simply never becomes the variable you wanted.
#
#     VAULT=$(az keyvault list -g rg-librechat-prod --query "[0].name" -o tsv)
#     az keyvault secret set --vault-name "$VAULT" \
#       --name OPENID-CLIENT-SECRET --value '...'
#
# Your vault's name carries a short uniqueness suffix, because key vault names
# must be unique across the whole of Azure rather than just your subscription.
# Look it up as above rather than guessing it.
#
# =============================================================================


# =============================================================================
# 1. REQUIRED IN KEY VAULT BEFORE THE FIRST DEPLOY
# =============================================================================
# The stack will not come up without these.

# --- Encryption of users' stored provider API keys ---------------------------
#
# ⚠️  ⚠️  MIGRATING AN EXISTING INSTALL? COPY THESE VERBATIM FROM THE OLD HOST,
# BEFORE YOU DO ANYTHING ELSE.
#
# These two encrypt every API key your users have saved. Generating new values
# does not produce an error and does not lose any data you can see — it makes
# every stored key permanently undecryptable, and you find out when users report
# that their keys stopped working. There is no recovery.
#
# For a NEW install, generate them:
#     CREDS_KEY:  openssl rand -hex 32     (64 hex characters)
#     CREDS_IV:   openssl rand -hex 16     (32 hex characters)
#
# For a migration, transfer them machine to machine and verify by checksum
# without ever displaying them: docs/modules/migrating-an-existing-install.md.
CREDS_KEY=
CREDS_IV=

# --- Session signing ---------------------------------------------------------
# Regenerating these is safe. It forces everyone to sign in again once.
#     openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Admin Panel -------------------------------------------------------------
# ⚠️  New and REQUIRED in v0.8.7. The admin panel container refuses to start
# without it, and the failure looks like an unrelated crash loop. This is the
# variable most often missed when upgrading from an older LibreChat.
#     openssl rand -hex 32
ADMIN_PANEL_SESSION_SECRET=

# --- Search index ------------------------------------------------------------
# Safe to regenerate: the index rebuilds itself from MongoDB.
#     openssl rand -hex 32
MEILI_MASTER_KEY=

# --- Vector database ---------------------------------------------------------
# Safe to regenerate ONLY on a fresh install. On an existing one it must match
# what is already in the pgvector data directory.
#     openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Your hostnames ----------------------------------------------------------
# These four change at cutover, when staging hostnames are replaced by
# production ones. Update them in Key Vault and redeploy; Caddy then requests
# certificates for the new names automatically.
#
#   CHAT_DOMAIN / ADMIN_DOMAIN   bare hostnames, no scheme  (used by the Caddyfile)
#   DOMAIN_CLIENT / DOMAIN_SERVER / ADMIN_PANEL_URL   full URLs including https://
CHAT_DOMAIN=
ADMIN_DOMAIN=
DOMAIN_CLIENT=
DOMAIN_SERVER=
ADMIN_PANEL_URL=

# Where Let's Encrypt sends certificate expiry warnings. Use an address a human
# reads — it is how you learn about a renewal failure before your users do.
ACME_EMAIL=

# --- At least one model provider ---------------------------------------------
# You need at least one of these for the application to be useful.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=


# =============================================================================
# 2. SET IN env.defaults, OVERRIDE IN KEY VAULT IF YOU NEED TO
# =============================================================================
# Every variable in this section already has a working value in env.defaults.
# They are listed here so the catalogue is complete and so you know they exist.
# See env.defaults for what each one is currently set to and why.

# Deployment
DATA_DIR=
FILE_STORAGE=
COMPOSE_PROFILES=
DEPLOY_TIMER_ENABLED=

# Models — read docs/modules/models-gpt56-responses.md before editing OPENAI_MODELS
ENDPOINTS=
ANTHROPIC_MODELS=
OPENAI_MODELS=

# Specialist models — frozen; see env.defaults for why each one is
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=
IMAGE_GEN_OAI_MODEL=
OPENAI_MODERATION=

# Server
SEARCH=
MEILI_NO_ANALYTICS=
TRUST_PROXY=
NO_INDEX=
CONSOLE_JSON=
RAG_PORT=
POSTGRES_DB=
POSTGRES_USER=
ADMIN_PANEL_SESSION_COOKIE_SECURE=

# Branding. The logo and favicons are files, not variables — see
# docs/modules/branding.md.
APP_TITLE=
CUSTOM_FOOTER=
HELP_AND_FAQ_URL=

# Authentication
ALLOW_EMAIL_LOGIN=
ALLOW_REGISTRATION=
ALLOW_SOCIAL_LOGIN=
ALLOW_SOCIAL_REGISTRATION=
ALLOW_PASSWORD_RESET=
ALLOW_UNVERIFIED_EMAIL_LOGIN=
ALLOW_ACCOUNT_DELETION=
SESSION_EXPIRY=
REFRESH_TOKEN_EXPIRY=


# =============================================================================
# 3. OPTIONAL MODULES
# =============================================================================
# Each block is inert until you fill it in. Nothing below is needed for a
# working instance.

# --- Single sign-on (OIDC) ---------------------------------------------------
# Entra ID, Google Workspace and Okta all speak OIDC. Full walkthrough:
# docs/modules/sso-oidc.md.
#
# Turning this on means setting ALLOW_SOCIAL_LOGIN=true, and usually
# ALLOW_REGISTRATION=false so that your identity provider is the only way in.
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_ISSUER=
OPENID_SESSION_SECRET=
OPENID_SCOPE=
OPENID_CALLBACK_URL=
OPENID_BUTTON_LABEL=
OPENID_IMAGE_URL=
OPENID_AUTO_REDIRECT=
OPENID_USE_PKCE=

# Which group claim grants the ADMIN role, and where to find it in the token.
# This is what gates the Admin Panel.
OPENID_ADMIN_ROLE=
OPENID_ADMIN_ROLE_PARAMETER_PATH=
OPENID_ADMIN_ROLE_TOKEN_KIND=
OPENID_REQUIRED_ROLE=
OPENID_REQUIRED_ROLE_PARAMETER_PATH=
OPENID_REQUIRED_ROLE_TOKEN_KIND=

# Entra ID only: look up colleagues when sharing an agent, instead of typing
# addresses by hand.
USE_ENTRA_ID_FOR_PEOPLE_SEARCH=
ENTRA_ID_INCLUDE_OWNERS_AS_MEMBERS=
OPENID_GRAPH_SCOPES=

# --- Code interpreter --------------------------------------------------------
# Runs generated code in a sandbox on a SEPARATE VM — it needs /dev/kvm, which
# is why it cannot be a container in this stack. docs/modules/code-interpreter.md.
#
# LibreChat mints a short-lived per-user EdDSA token for every execution; there
# is no static shared API key and users never enter one. Every value except the
# private key must mirror the interpreter VM's own configuration exactly — a
# mismatch in issuer, audience, tenant or key id produces a 401 at execution
# time with no clue as to which field is wrong.
#
# Requires interface.runCode: true in librechat.yaml.
LIBRECHAT_CODE_BASEURL=
CODEAPI_AUTH_PROVIDER=
CODEAPI_JWT_ALGORITHM=
CODEAPI_JWT_KID=
CODEAPI_JWT_ISSUER=
CODEAPI_JWT_AUDIENCE=
CODEAPI_JWT_TTL_SECONDS=
CODEAPI_JWT_MINT_CACHE_SECONDS=
CODEAPI_JWT_SINGLE_TENANT_ID=
# The Ed25519 PRIVATE key, as one line of JSON. The interpreter VM holds only
# the matching public JWKS. Generate both halves together.
CODEAPI_JWT_PRIVATE_JWK_JSON=

# --- Speech to text ----------------------------------------------------------
# The model is pinned in librechat.yaml, not here.
STT_API_KEY=

# --- Image generation --------------------------------------------------------
IMAGE_GEN_OAI_API_KEY=

# --- Web search --------------------------------------------------------------
# ⚠️  Web search sends the query to a third party. If your terms of service
# promise confidentiality, say plainly that this feature is outside that
# boundary — see the modal in librechat.yaml for how Maryland Legal Aid words it.
# Set the providers you have accounts with; unset ones are simply unavailable.
SERPER_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
JINA_API_KEY=

# --- Outbound email ----------------------------------------------------------
# Needed only for password reset and email verification. Not needed at all if
# everyone signs in through single sign-on.
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_ENCRYPTION=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

# --- S3 file storage ---------------------------------------------------------
# Two different situations use these, and they are worth telling apart:
#
#   1. FILE_STORAGE=s3 — new uploads go to the bucket.
#
#   2. FILE_STORAGE=disk with AWS_* still set — new uploads go to the data disk
#      while file records created earlier, which carry `source: s3`, keep being
#      served from the bucket. This is what an organization migrating off S3
#      wants: no bulk copy, no database rewrite, nothing to go wrong. Maryland
#      Legal Aid runs exactly this for 2,040 legacy files.
#
# docs/modules/storage-s3-legacy.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ENDPOINT_URL=

# --- LegalServer MCP tools (COMPOSE_PROFILES=mcp-legalserver) -----------------
# Read-only matter, document and discovery tools for organizations running
# LegalServer. docs/modules/mcp-legalserver.md.
LEGALSERVER_BASE_URL=
LEGALSERVER_BEARER_TOKEN=
LEGALSERVER_TIMEOUT_MS=
LEGALSERVER_USER_EMAIL_HEADER=
LEGALSERVER_CURRENT_USER_EVENTS_REPORT_URL=
LEGALSERVER_CURRENT_USER_TASKS_REPORT_URL=
LEGALSERVER_CURRENT_USER_MATTERS_REPORT_URL=

# OCR for scanned documents. `none` and empty both mean off; `none` is set
# explicitly so the choice is visible rather than merely absent. Off, the
# document tools work on native-digital PDFs — a scan returns nothing, which is
# expected behaviour rather than a fault.
#
# Turning it on is a policy decision more than a configuration one, and the two
# reasons this deployment leaves it off will likely apply to yours:
#
#   - Every supported provider sends page images to a third party. A scanned
#     document is whatever the client walked in with, so it is a broader
#     disclosure than a prompt somebody chose to type, and having an agreement
#     with the vendor does not settle whether client documents belong there.
#   - Local OCR (Tesseract, PaddleOCR) keeps the pages on your own hardware but
#     needs CPU this VM does not have. A multi-page scan would saturate the four
#     vCPUs the whole stack shares and would likely blow the tool-call timeout,
#     reaching the user as a tool that hangs and then fails.
#
# Read docs/modules/mcp-legalserver.md before changing this — it lists what
# would make OCR reasonable, and what else you have to update if you enable it.
# scripts/check-secrets.sh validates these if you do, so a half-configured
# provider fails loudly.
#
#   openai         uses OPENAI_API_KEY from section 2 — the same key the chat
#                  endpoint uses, which is its own question to answer.
#   openrouter     needs OPENROUTER_API_KEY; images are proxied to the model.
#   vertex_gemini  cannot work here at all: it authenticates with a
#                  service-account JSON FILE at the path in
#                  GOOGLE_APPLICATION_CREDENTIALS, and legalserver-mcp mounts no
#                  volumes. Key Vault cannot supply one either — render-env.sh
#                  refuses multi-line secrets, and this variable holds a path
#                  rather than the credential. It needs a compose.yaml change.
DOCUMENT_OCR_PROVIDER=none
DOCUMENT_OCR_MODEL=
OPENROUTER_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# --- LetterWriter MCP tool (COMPOSE_PROFILES=mcp-letterwriter) ----------------
# Generates letters on your letterhead. The .docx templates themselves live on
# the data disk and are never committed to git.
# docs/modules/mcp-letterwriter.md.
ORGANIZATION_NAME=
LETTERHEAD_DIR=

# --- Optional shared secret for the MCP servers ------------------------------
# Left unset on purpose: the MCP containers publish no ports and the Compose
# network is the trust boundary. Set it if you ever move an MCP server onto a
# different host. Both images ignore it when it is empty.
MCP_SHARED_SECRET=

# --- Backups -----------------------------------------------------------------
# scripts/backup-mongo.sh writes a nightly dump to Azure Blob Storage. Azure
# Backup protects the VM and data disk separately and is configured in Bicep.
# docs/modules/backups.md.
BACKUP_STORAGE_ACCOUNT=
BACKUP_CONTAINER=
BACKUP_RETENTION_DAYS=


# =============================================================================
# 4. SET AUTOMATICALLY — DO NOT PUT THESE IN KEY VAULT
# =============================================================================
# compose.yaml sets these from the Compose network topology. Overriding them
# will break the stack in ways that are tedious to diagnose.
#
#   HOST, MONGO_URI, MEILI_HOST, RAG_API_URL, DB_HOST, DB_PORT,
#   LIBRECHAT_LOG_DIR, API_SERVER_URL, VITE_API_BASE_URL, SESSION_SECRET,
#   MCP_HTTP_HOST, MCP_HTTP_PORT, MCP_ALLOWED_HOSTS
#
# Also do not set ASSISTANTS_API_KEY. The `assistants` endpoint is not in
# ENDPOINTS; carrying that key forward from an older install is dead config.
