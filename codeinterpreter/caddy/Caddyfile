# =============================================================================
# Caddy — TLS for the code interpreter API.
# =============================================================================
# CODE_DOMAIN and ACME_EMAIL come from the environment (Key Vault). Its DNS A
# record must point at this VM before the first start, or certificate issuance
# fails — and Let's Encrypt allows only five failed validations per hostname
# per hour. docs/modules/code-interpreter.md has a check to run first.
#
# Port 80 is closed on this machine, so the certificate comes over the TLS-ALPN
# challenge on 443. Caddy picks that automatically when 80 is unreachable.
#
# Mounted as a directory (compose.yaml), so an edit arrives with the next
# deploy. Caddy still reads it only at start; deploy restarts Caddy when this
# directory changes.
# =============================================================================

{
	email {$ACME_EMAIL}
}

{$CODE_DOMAIN} {
	# Prometheus metrics are for the health snapshot on loopback, not the world.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# The bring-your-own-machine bridge. Disabled in compose.yaml; refused here
	# too, so enabling it later is a deliberate two-file change.
	@bridge path /v1/bridge /v1/bridge/*
	respond @bridge 404

	# Uploads: refused HERE when the whole request reaches 50 MiB, so the API
	# never sees a file over its own MAX_FILE_SIZE. It must not: when the API
	# rejects an oversized upload, it throws an uncaught "Controller is already
	# closed" and the whole process restarts, killing every execution in flight
	# (upstream #266, open). LibreChat's own default upload limit is 512 MB, so
	# a user can send one.
	#
	# request_buffers makes Caddy read the body in full before contacting the
	# API, so the limit trips before a byte is proxied. Without it the API would
	# receive a truncated stream, which is no safer.
	#
	# The cost: a batch upload whose files together reach 50 MiB is refused too.
	# Keep this in step with MAX_FILE_SIZE in env.defaults.
	@upload path /v1/upload /v1/upload/batch
	handle @upload {
		request_body {
			max_size 50MiB
		}
		reverse_proxy api:3112 {
			request_buffers 51MiB
		}
	}

	# Everything else is small JSON; this is only a coarse outer limit.
	handle {
		request_body {
			max_size 60MB
		}
		reverse_proxy api:3112
	}
}
