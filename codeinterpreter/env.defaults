# =============================================================================
# Code interpreter: non-secret defaults. COMMITTED; never put a secret here.
# =============================================================================
# The first half of codeinterpreter/.env, which scripts/render-env.sh builds on
# the interpreter VM:
#
#     codeinterpreter/env.defaults  →  that VM's Key Vault  →  codeinterpreter/.env
#
# Key Vault wins, exactly as on the chat VM. To change a value for your own
# deployment, set a secret of the same name (dashes for underscores) rather than
# editing this file.
#
# Per-deployment values are deliberately absent and must be in Key Vault:
#   CODE_DOMAIN, ACME_EMAIL, CODEAPI_JWT_KID, CODEAPI_JWT_SINGLE_TENANT_ID,
#   CODEAPI_JWT_JWKS_JSON, and the secrets that
#   scripts/codeinterpreter-seed-secrets.sh generates.
#
# Several values below are promises in the terms of service in librechat.yaml
# (section 5). Changing them means changing that text too; each is marked ToS.
# =============================================================================


# --- Authentication -----------------------------------------------------------
# Must match the chat VM's CODEAPI-JWT-* settings exactly. A mismatch is an
# opaque 401 at execution time; docs/modules/code-interpreter.md has the check.
CODEAPI_JWT_ISSUER=librechat
CODEAPI_JWT_AUDIENCE=codeapi
CODEAPI_JWT_ALLOWED_ALGS=EdDSA
CODEAPI_JWT_CLOCK_SKEW_SECONDS=30
CODEAPI_JWT_MAX_TTL_SECONDS=300
CODEAPI_JWT_KEY_CACHE_TTL_SECONDS=30


# --- Capacity (sized for a Standard_D2s_v5) ---------------------------------
# Two executions at once, each a micro-VM with 2 vCPU and 2 GiB, of which the
# program itself may use 1.5 GiB.
SANDBOX_MAX_CONCURRENT_JOBS=2
PYTHON_CONCURRENCY=1
OTHER_CONCURRENCY=1
LAUNCHER_VCPUS=2
LAUNCHER_RAM_MIB=2048
SANDBOX_RUN_MEMORY_LIMIT=1610612736


# --- Time limits (milliseconds) ---------------------------------------------
JOB_TIMEOUT=600000
SANDBOX_RUN_TIMEOUT=600000
SANDBOX_RUN_CPU_TIME=600000


# --- Size limits --------------------------------------------------------------
# ToS: "each file ... must be under 50 MB". 50 MiB per file. In practice slightly less: Caddy refuses any upload REQUEST
# of 50 MiB, multipart framing included, so the API never sees a file it would
# reject (that rejection crashes it; see caddy/Caddyfile). Change the Caddyfile
# limit with this one.
MAX_FILE_SIZE=52428800
EGRESS_GATEWAY_MAX_FILE_BYTES=52428800
EXECUTION_MANIFEST_MAX_UPLOAD_BYTES=52428800
EXECUTION_MANIFEST_MAX_OUTPUT_FILES=10
CODEAPI_HTTP_JSON_LIMIT=60mb
SANDBOX_EXECUTE_BODY_LIMIT=60mb


# --- Retention ----------------------------------------------------------------
# ToS: "workspaces are removed after one hour".
SANDBOX_WORKSPACE_REAPER_MAX_AGE_SECONDS=3600
# ToS: "session files are deleted after 24 hours". The cache key that lets a
# user fetch a file lasts as long as the file; the cleanup job deletes it.
SESSION_CACHE_TTL=86400
FILE_RETENTION=24h
# A file older than this means cleanup is not keeping the promise; it alerts.
FILE_OVERDUE_AGE=26h


# --- Session-file store -------------------------------------------------------
FILE_STORE_BUCKET=codeapi-files


# --- Logging ------------------------------------------------------------------
SANDBOX_LOG_LEVEL=INFO
